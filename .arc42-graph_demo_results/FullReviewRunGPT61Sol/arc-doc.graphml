    <edge id="s11-risk-spielstaerke--threatens--s01-qg-spielstaerke" source="s11-risk-spielstaerke" target="s01-qg-spielstaerke">
      <data key="e0">threatens</data>
      <data key="e1">Abschnitt 11.3 nennt ausdrücklich das Qualitätsziel akzeptable Spielstärke und das Risiko zu schlechter Spielstärke.</data>
      <data key="e2">explicit</data>
    </edge>
    <edge id="s11-risk-spielstaerke--threatens--s01-qg-effizienz" source="s11-risk-spielstaerke" target="s01-qg-effizienz">
      <data key="e0">threatens</data>
      <data key="e1">Abschnitt 11.3 nennt ausdrücklich Effizienz und zu lange Wartezeiten als mögliche Manifestation.</data>
      <data key="e2">explicit</data>
    </edge>
    <edge id="s11-risk-spielstaerke--threatens--s01-qg-zugaenglich" source="s11-risk-spielstaerke" target="s01-qg-zugaenglich">
      <data key="e0">threatens</data>
      <data key="e1">Risiko 11.3 nennt eine einfache, leicht zugängliche Lösung; Zuordnung zum Qualitätsziel Zugängliches Beispiel ist thematisch abgeleitet.</data>
      <data key="e2">inferred</data>
    </edge>
