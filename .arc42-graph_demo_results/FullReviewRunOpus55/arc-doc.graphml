    <node id="s00-sys-dokchess">
      <data key="d0">DokChess</data>
      <data key="d1">System</data>
      <data key="d2">0</data>
      <data key="d3">„DokChess ist eine voll funktionsfähige Schach-Engine.“ Architekturüberblick gegliedert nach arc42; Zielgruppe in erster Linie Softwarearchitektinnen und -architekten, darüber hinaus alle, die selbst ein Schachprogramm schreiben wollen.</data>
      <data key="d7">00-Ueberblick/00-00-Overview.md</data>
      <data key="d8">## DokChess</data>
    </node>
    <node id="s01-req-schach-engine">
      <data key="d0">Voll funktionsfähige Schach-Engine</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">„DokChess ist eine voll funktionsfähige Schach-Engine.“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Was ist DokChess?</data>
    </node>
    <node id="s01-req-fallbeispiel">
      <data key="d0">Fallbeispiel für Architekturentwurf, -bewertung und -dokumentation</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">„Sie dient als einfach zugängliches und zugleich attraktives Fallbeispiel für Architekturentwurf, -bewertung und -dokumentation.“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Was ist DokChess?</data>
    </node>
    <node id="s01-req-experimentieren">
      <data key="d0">Einladung zum Experimentieren und Erweitern</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">„Der verständliche Aufbau lädt zum Experimentieren und zum Erweitern der Engine ein.“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Was ist DokChess?</data>
    </node>
    <node id="s01-req-spielstaerke">
      <data key="d0">Keine höchstmögliche Spielstärke, aber Freude für Gelegenheitsspieler</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">„Ziel ist nicht die höchstmögliche Spielstärke – dennoch gelingen Partien, die Gelegenheitsspielern Freude bereiten.“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Was ist DokChess?</data>
    </node>
    <node id="s01-req-fide-regeln">
      <data key="d0">Vollständige Implementierung der FIDE-Schachregeln</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">Feature: „Vollständige Implementierung der FIDE-Schachregeln“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Wesentliche Features</data>
    </node>
    <node id="s01-req-gegner">
      <data key="d0">Spiel gegen menschliche Gegner und andere Schachprogramme</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">Feature: „Unterstützt das Spiel gegen menschliche Gegner und andere Schachprogramme“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Wesentliche Features</data>
    </node>
    <node id="s01-req-taktik">
      <data key="d0">Taktische Ideen (Gabel, Spieß)</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">Feature: „Beherrscht zentrale taktische Ideen, beispielsweise Gabel und Spieß“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Wesentliche Features</data>
    </node>
    <node id="s01-req-frontends">
      <data key="d0">Integration mit grafischen Schach-Frontends</data>
      <data key="d1">Requirement</data>
      <data key="d2">1.1</data>
      <data key="d3">Feature: „Integration mit modernen grafischen Schach-Frontends“</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-01-Aufgabenstellung.md</data>
      <data key="d8">### Wesentliche Features</data>
    </node>
    <node id="s01-qg-analysierbarkeit">
      <data key="d0">Zugängliches Beispiel (Analysierbarkeit)</data>
      <data key="d1">QualityGoal</data>
      <data key="d2">1.2</data>
      <data key="d3">„Da DokChess in erster Linie als Anschauungsmaterial für Softwarearchitektur und -entwicklung dient, erschließen sich Entwurf und Implementierung rasch.“ Reihenfolge der Tabelle ist laut Text „eine grobe Orientierung bezüglich der Wichtigkeit“.</data>
      <data key="d5">1</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-02-Qualitaetsziele.md</data>
      <data key="d8">## 1.2 Qualitätsziele</data>
    </node>
    <node id="s01-qg-aenderbarkeit">
      <data key="d0">Einladende Experimentierplattform (Änderbarkeit)</data>
      <data key="d1">QualityGoal</data>
      <data key="d2">1.2</data>
      <data key="d3">„Alternative Algorithmen und Strategien, etwa zur Bewertung einer Schachstellung, können leicht implementiert und in die Lösung integriert werden.“</data>
      <data key="d5">2</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-02-Qualitaetsziele.md</data>
      <data key="d8">## 1.2 Qualitätsziele</data>
    </node>
    <node id="s01-qg-interoperabilitaet">
      <data key="d0">Bestehende Frontends nutzen (Interoperabilität)</data>
      <data key="d1">QualityGoal</data>
      <data key="d2">1.2</data>
      <data key="d3">„DokChess lässt sich mit angemessenem Aufwand in bestehende grafische Schach-Frontends einbinden.“</data>
      <data key="d5">3</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-02-Qualitaetsziele.md</data>
      <data key="d8">## 1.2 Qualitätsziele</data>
    </node>
    <node id="s01-qg-funktionale-eignung">
      <data key="d0">Akzeptable Spielstärke (Funktionale Eignung)</data>
      <data key="d1">QualityGoal</data>
      <data key="d2">1.2</data>
      <data key="d3">„DokChess spielt stark genug, um schwache Gegner sicher zu schlagen und Gelegenheitsspieler zumindest zu fordern.“</data>
      <data key="d5">4</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-02-Qualitaetsziele.md</data>
      <data key="d8">## 1.2 Qualitätsziele</data>
    </node>
    <node id="s01-qg-effizienz">
      <data key="d0">Schnelles Antworten auf Züge (Effizienz)</data>
      <data key="d1">QualityGoal</data>
      <data key="d2">1.2</data>
      <data key="d3">„Da DokChess in Seminaren und Vorträgen live demonstriert wird, erfolgt die Berechnung der Spielzüge rasch.“ (keine Zahl genannt; Konkretisierung über Verweis auf Abschnitt 10)</data>
      <data key="d5">5</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-02-Qualitaetsziele.md</data>
      <data key="d8">## 1.2 Qualitätsziele</data>
    </node>
    <node id="s01-sh-architekten">
      <data key="d0">Softwarearchitektinnen und -architekten</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">1.3</data>
      <data key="d3">„wollen ein Gefühl bekommen, wie Architekturdokumentation für ein konkretes System aussehen kann“; „möchten sich Dinge (z.B. Form, Notation) … abgucken“; „gewinnen Sicherheit für Ihre eigenen Dokumentationsvorhaben“; „haben in der Regel keine tiefen Schachkenntnisse“</data>
      <data key="d6">Zielgruppe</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-03-Stakeholder.md</data>
      <data key="d8">## 1.3 Stakeholder</data>
    </node>
    <node id="s01-sh-entwickler">
      <data key="d0">Entwicklerinnen und Entwickler</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">1.3</data>
      <data key="d3">„nehmen auch Architekturaufgaben im Team wahr“; „bekommen beim Studium von DokChess Lust, selbst eine Schach-Engine zu implementieren“; „sind neugierig auf konkrete Anregungen, wie man das macht“</data>
      <data key="d6">Zielgruppe</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-03-Stakeholder.md</data>
      <data key="d8">## 1.3 Stakeholder</data>
    </node>
    <node id="s01-sh-zoerner">
      <data key="d0">Stefan Zörner</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">1.3</data>
      <data key="d3">„benötigt attraktive Beispiele für sein Buch“; „will DokChess in Workshops und Vorträgen … als Anschauungsmaterial verwenden“</data>
      <data key="d6">Autor</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-03-Stakeholder.md</data>
      <data key="d8">## 1.3 Stakeholder</data>
    </node>
    <node id="s01-sh-oose">
      <data key="d0">oose Innovative Informatik</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">1.3</data>
      <data key="d3">„Schulungsunternehmen, Arbeitgeber von Stefan Zörner zum Zeitpunkt der Konzeption von DokChess“; „bietet Seminare, Workshops und Coaching … an“</data>
      <data key="d6">Organisation</data>
      <data key="d7">01-Einfuehrung-und-Ziele/01-03-Stakeholder.md</data>
      <data key="d8">## 1.3 Stakeholder</data>
    </node>
    <node id="s02-con-hardware">
      <data key="d0">Moderate Hardwareausstattung</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.1</data>
      <data key="d3">„Betrieb der Lösung auf einem marktüblichen Standard-Notebook, um sie im Rahmen von Seminaren und Konferenzen auf einem solchen zeigen zu können.“</data>
      <data key="d6">technisch</data>
      <data key="d7">02-Randbedingungen/02-01-Technisch.md</data>
      <data key="d8">## 2.1 Technische Randbedingungen</data>
    </node>
    <node id="s02-con-windows">
      <data key="d0">Betrieb auf Windows Desktop Betriebssystemen</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.1</data>
      <data key="d3">„Standardausstattung von Notebooks bei Mitarbeitern des Schulungsunternehmens zum Zeitpunkt der Konzeption … Unterstützung anderer Betriebssysteme (allen voran Linux und Mac OS X) wünschenswert, aber nicht zwingend erforderlich.“</data>
      <data key="d6">technisch</data>
      <data key="d7">02-Randbedingungen/02-01-Technisch.md</data>
      <data key="d8">## 2.1 Technische Randbedingungen</data>
    </node>
    <node id="s02-con-java">
      <data key="d0">Implementierung in Java</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.1</data>
      <data key="d3">„Einsatz als Beispiel in Java-lastigen Seminaren und auf Java-Konferenzen. Entwicklung unter Version Java SE 6 (DokChess 1.0), später Java SE 7 und Java SE 11. Die Engine soll auch auf neueren Java-Versionen, sobald verfügbar, laufen.“</data>
      <data key="d6">technisch</data>
      <data key="d7">02-Randbedingungen/02-01-Technisch.md</data>
      <data key="d8">## 2.1 Technische Randbedingungen</data>
    </node>
    <node id="s02-con-fremdsoftware-frei">
      <data key="d0">Fremdsoftware frei verfügbar</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.1</data>
      <data key="d3">„Falls zur Lösung Fremdsoftware hinzugezogen wird (z.B. grafisches Frontend), sollte diese idealerweise frei verfügbar und kostenlos sein.“</data>
      <data key="d6">technisch</data>
      <data key="d7">02-Randbedingungen/02-01-Technisch.md</data>
      <data key="d8">## 2.1 Technische Randbedingungen</data>
    </node>
    <node id="s02-con-team">
      <data key="d0">Team</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.2</data>
      <data key="d3">„Stefan Zörner, unterstützt durch Kollegen, Bekannte und Interessierte aus Workshops und Seminaren“</data>
      <data key="d6">organisatorisch</data>
      <data key="d7">02-Randbedingungen/02-02-Organisatorisch.md</data>
      <data key="d8">## 2.2 Organisatorische Randbedingungen</data>
    </node>
    <node id="s02-con-zeitplan">
      <data key="d0">Zeitplan</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.2</data>
      <data key="d3">„Beginn der Entwicklung Dezember 2010, erster lauffähiger Prototyp März 2011 (Abendvortrag beim Schulungsunternehmenin Hamburg), vorzeigbare Version Mai 2011 (Vortrag JAX-Konferenz in Mainz). Fertigstellung Version 1.0: Februar 2012“ (Tippfehler „Schulungsunternehmenin“ im Original)</data>
      <data key="d6">organisatorisch</data>
      <data key="d7">02-Randbedingungen/02-02-Organisatorisch.md</data>
      <data key="d8">## 2.2 Organisatorische Randbedingungen</data>
    </node>
    <node id="s02-con-vorgehensmodell">
      <data key="d0">Vorgehensmodell</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.2</data>
      <data key="d3">„Entwicklung risikogetrieben, iterativ und inkrementell. Zur Dokumentation der Architektur kommt arc42 zum Einsatz.“</data>
      <data key="d6">organisatorisch</data>
      <data key="d7">02-Randbedingungen/02-02-Organisatorisch.md</data>
      <data key="d8">## 2.2 Organisatorische Randbedingungen</data>
    </node>
    <node id="s02-con-werkzeuge">
      <data key="d0">Entwicklungswerkzeuge</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.2</data>
      <data key="d3">„Entwurf mit Stift und Papier, ergänzend Enterprise Architect. … Confluence Wiki. … Eclipse oder IntelliJ. Die Software muss jedoch auch, allein mit Gradle, also ohne IDE baubar sein.“</data>
      <data key="d6">organisatorisch</data>
      <data key="d7">02-Randbedingungen/02-02-Organisatorisch.md</data>
      <data key="d8">## 2.2 Organisatorische Randbedingungen</data>
    </node>
    <node id="s02-con-versionsverwaltung">
      <data key="d0">Konfigurations- und Versionsverwaltung</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.2</data>
      <data key="d3">„Zu Beginn (Version 1.0) Subversion bei SourceForge, später Git bei GitHub“</data>
      <data key="d6">organisatorisch</data>
      <data key="d7">02-Randbedingungen/02-02-Organisatorisch.md</data>
      <data key="d8">## 2.2 Organisatorische Randbedingungen</data>
    </node>
    <node id="s02-con-testwerkzeuge">
      <data key="d0">Testwerkzeuge und -prozesse</data>
      <data key="d1">Constraint</data>
      <data key="d2">2.2</data>
      <data key="d3">„JUnit im Annotationsstil sowohl für inhaltliche Richtigkeit als auch für Integrationstests und die Einhaltung von Effizienzvorgaben“</data>
      <data key="d6">organisatorisch</data>
      <data key="d7">02-Randbedingungen/02-02-Organisatorisch.md</data>
