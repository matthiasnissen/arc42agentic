      <data key="e2">inferred</data>
    </edge>
    <edge id="s10-qs-w05--references--s09-adr-02-stellungsobjekte" source="s10-qs-w05" target="s09-adr-02-stellungsobjekte">
      <data key="e0">references</data>
      <data key="e1">W05 Bitboard-Austausch ↔ ADR 9.2: „von der Schnittstelle der Stellung saemtliche Module abhaengen. Eine spaetere Aenderung wuerde das Gesamtsystem betreffen.“</data>
      <data key="e2">inferred</data>
    </edge>
